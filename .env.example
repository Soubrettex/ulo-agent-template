# Google OAuth (Calendar + Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Google Maps Platform (Weather, Air Quality, Routes)
GOOGLE_MAPS_API_KEY=

# Browserbase (web search, form filling, authenticated browsing)
BROWSERBASE_API_KEY=

# Supabase (memory, processed emails)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 1Password (optional — for authenticated browsing)
OP_SERVICE_ACCOUNT_TOKEN=

# Allowed iMessage senders (comma-separated phone numbers)
ALLOWED_SENDERS=+15551234567,+15559876543

# Home address (for travel time calculations)
HOME_ADDRESS=123 Main St, Your City, ST
